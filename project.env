# ---------------------------------------------------------------------------
# Single source of truth for every name used by the scripts and the workflow.
# Change a value here and nothing else has to be edited.
# ---------------------------------------------------------------------------
GITHUB_USER="twooooooh-boop"
REPO_NAME="the-interpreter-android"

APP_NAME="The Interpreter"            # name under the launcher icon
APP_ID="com.twooooooh.interpreter"    # Android package id (letters/digits/dots only)
APK_NAME="TheInterpreter"             # file name of the built APK

VERSION_NAME="1.0.0"
VERSION_CODE="1"                      # CI replaces this with the run number
ORIENTATION="portrait"                # portrait | landscape | sensor ...

LOVE_ANDROID_TAG="11.5a"              # LÖVE 11.5 for Android (same engine as your old APK)
